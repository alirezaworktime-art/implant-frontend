# cc4: keep LF in every checkout (Windows core.autocrlf=true made the working copy CRLF and builds differ from the released bundles)
* text=auto eol=lf
*.apk binary
*.png binary
*.jpg binary
*.ico binary
*.jar binary
*.zip binary
*.db binary
*.pdf binary
# generated by tools/build.mjs from src/ — do not edit, do not merge by hand: rebuild
index.html linguist-generated=true -diff
p.html linguist-generated=true -diff
f.html linguist-generated=true -diff
probe.html linguist-generated=true -diff
